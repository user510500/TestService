{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  },

  "ConnectionStrings": {
    "MySql": "server=localhost;port=3306;database=testservice;user=root;password=123456;CharacterSet=utf8mb4;SslMode=None;AllowPublicKeyRetrieval=true;"
  },

  "Jwt": {
    "Issuer": "TestService",
    "Audience": "TestService.Client",
    "Secret": "test-service-secret-key-must-be-at-least-32-characters-long",
    "ExpiresMinutes": 480
  },

  "Redis": {
    "ConnectionString": "localhost:6379,password=,abortConnect=false",
    "Prefix": "TestService:"
  },

  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "admin",
    "Password": "admin123",
    "VirtualHost": "/",
    "EnableConsumer": true
  }
}
